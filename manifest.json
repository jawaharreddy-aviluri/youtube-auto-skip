{
  "manifest_version": 3,
  "name": "YouTube Auto Skip Ads",
  "description": "Automatically clicks the YouTube 'Skip Ads' button as soon as it becomes available.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
  "default_title": "YouTube Auto Skip Ads"
    },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.youtube.com/embed/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "permissions": [],
  "offline_enabled": false
}
