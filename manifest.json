{
  "manifest_version": 3,
  "name": "YouTube Auto Skip Ads",
  "description": "Automatically clicks YouTube's Skip Ads button the instant it appears.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.m.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.m.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ]
}
